{
  "manifest_version": 3,
  "name": "RoutineEnglish — 내 일상 속 영어 코치",
  "version": "0.6.0",
  "minimum_chrome_version": "120",
  "description": "AI가 목표와 커리큘럼을 준비하고, 지금 보는 페이지로 대화와 복습을 제안합니다. 개인 OpenAI API 키를 사용합니다.",
  "permissions": ["storage", "alarms", "notifications", "sidePanel", "activeTab", "scripting", "contextMenus", "idle"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "지금 하는 일로 영어 대화"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}},
  "side_panel": {"default_path": "panel.html"},
  "options_page": "options.html",
  "icons": {"128": "icon.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openai.com;"}
}
